# 本机首次使用不必复制此文件；双击根目录「启动网站.bat」，在网页完成设置即可。
# 手动配置 / 正式部署时才使用：复制为 .env 并填写自己的密码。
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=jx_stamping_db
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
SESSION_SECRET=
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=
# 正式部署需设置以下项目并配好 HTTPS 反向代理：
# NODE_ENV=production
# COOKIE_SECURE=true
# TRUST_PROXY=1
# HOST=0.0.0.0
# PUBLIC_BASE_URL=https://portal.example.com
# DB_SSL=true
# DB_SSL_CA=/path/to/trusted-ca.pem
